// Find virtual networks referenced by Azure NetApp Files volumes.
// Derive each network ID from the volume's subnet ID and look up the matching network.
// Return details of both resources, including their locations.

resources
| where type =~ "microsoft.netapp/netappaccounts/capacitypools/volumes"
| extend subnetId = tolower(tostring(properties.subnetId))
| where subnetId has "/subnets/"
| extend linkedId = substring(subnetId, 0, indexof(subnetId, "/subnets/"))
| join kind=leftouter (resources
    | where type =~ "microsoft.network/virtualnetworks"
    | project linkedId = tolower(id), linkedName = name, linkedType = type, linkedRegion = location) on linkedId
| project
    primaryResourceName = name,
    primaryResourceId = id,
    primaryResourceLocation = location,
    primaryResourceType = type,
    linkedResourceId = linkedId,
    linkedResourceName = linkedName,
    linkedResourceType = linkedType,
    linkedResourceRegion = linkedRegion
