// Find virtual machines listed on Azure Dedicated Hosts.
// Expand each host's virtual machine references and look up matching Compute resources.
// Return host and virtual machine details, including their locations.

resources
| where type =~ "microsoft.compute/hostgroups/hosts"
| mv-expand link = properties.virtualMachines
| extend linkedJoinId = tolower(tostring(link.id))
| where isnotempty(linkedJoinId)
| distinct name, id, location, type, linkedJoinId
| join kind=leftouter (
    resources
    | where type =~ "microsoft.compute/virtualmachines"
    | project linkedJoinId = tolower(id), linkedId = id, linkedName = name, linkedType = type, linkedRegion = location
) on linkedJoinId
| where isnotempty(linkedId)
| project
    primaryResourceName = name,
    primaryResourceId = id,
    primaryResourceLocation = location,
    primaryResourceType = type,
    linkedResourceId = linkedId,
    linkedResourceName = linkedName,
    linkedResourceType = linkedType,
    linkedResourceRegion = linkedRegion
