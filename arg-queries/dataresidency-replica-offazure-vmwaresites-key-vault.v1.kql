// Find Key Vaults referenced by Azure Migrate VMware site agents.
// Read the Key Vault IDs in each site's agent details and return matching vault resources.
// Return details of both resources, including their locations.

resources
| where type =~ "microsoft.offazure/vmwaresites"
| extend rawLinkedId = tostring(properties.agentDetails.keyVaultId)
| extend linkedJoinId = tolower(rawLinkedId)
| where isnotempty(linkedJoinId)
| join kind=leftouter (
    resources
    | where type =~ "microsoft.keyvault/vaults"
    | project linkedJoinId = tolower(id), linkedId = id, linkedName = name, linkedType = type, linkedRegion = location
) on linkedJoinId
| where isnotempty(linkedId)
| project
    primaryResourceName = name,
    primaryResourceId = id,
    primaryResourceLocation = location,
    primaryResourceType = type,
    linkedResourceId = linkedId,
    linkedResourceName = linkedName,
    linkedResourceType = linkedType,
    linkedResourceRegion = linkedRegion
