resources
| where type =~ "microsoft.synapse/workspaces"
| extend linkedIdKey = tolower(tostring(properties.purviewConfiguration.purviewResourceId))
| where isnotempty(linkedIdKey)
| join kind=leftouter (
    resources
    | where type =~ "microsoft.purview/accounts"
    | extend linkedIdKey = tolower(id)
    | project linkedIdKey, linkedId=id, linkedName=name, linkedType=type, linkedRegion=location
) on linkedIdKey
| project
    primaryResourceName = name,
    primaryResourceId = id,
    primaryResourceLocation = location,
    primaryResourceType = type,
    linkedResourceId = linkedId,
    linkedResourceName = linkedName,
    linkedResourceType = linkedType,
    linkedResourceRegion = linkedRegion
