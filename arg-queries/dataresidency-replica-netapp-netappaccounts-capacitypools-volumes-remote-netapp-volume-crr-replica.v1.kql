// Find Azure NetApp Files replication destination volumes and their source volumes.
// Select destination endpoints and match their remote volume resource IDs to source volumes.
// Return each source volume's details alongside its destination's details, including both
// locations.

resources
| where type =~ "microsoft.netapp/netappaccounts/capacitypools/volumes"
| where tostring(properties.dataProtection.replication.endpointType) =~ "dst"
| extend primaryJoinId=tolower(tostring(properties.dataProtection.replication.remoteVolumeResourceId))
| where isnotempty(primaryJoinId)
| project primaryJoinId,linkedId=id,linkedName=name,linkedType=type,linkedRegion=location
| join kind=inner (
    resources
    | where type =~ "microsoft.netapp/netappaccounts/capacitypools/volumes"
    | project primaryJoinId=tolower(id),name,id,location,type
) on primaryJoinId
| project
    primaryResourceName = name,
    primaryResourceId = id,
    primaryResourceLocation = location,
    primaryResourceType = type,
    linkedResourceId = linkedId,
    linkedResourceName = linkedName,
    linkedResourceType = linkedType,
    linkedResourceRegion = linkedRegion
