// Find Key Vaults referenced by Azure Health Data Services DICOM service encryption settings.
// Extract vault URLs from the configured key URLs and match them to vault resource URLs.
// Return details of both resources, including their locations.

resources
| where type =~ "microsoft.healthcareapis/workspaces/dicomservices"
| extend keyUrl=tostring(properties.encryption.customerManagedKeyEncryption.keyEncryptionKeyUrl)
| where isnotempty(keyUrl)
| extend linkedJoinId=tolower(tostring(split(keyUrl, '/keys/')[0]))
| project name, id, location, type, linkedJoinId
| join kind=inner (
    resources
    | where type =~ "microsoft.keyvault/vaults"
| project linkedJoinId=tolower(trim_end('/', tostring(properties.vaultUri))), linkedId=id, linkedName=name, linkedType=type, linkedRegion=location
) on linkedJoinId
| project
    primaryResourceName = name,
    primaryResourceId = id,
    primaryResourceLocation = location,
    primaryResourceType = type,
    linkedResourceId = linkedId,
    linkedResourceName = linkedName,
    linkedResourceType = linkedType,
    linkedResourceRegion = linkedRegion
