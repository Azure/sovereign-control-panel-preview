resources
| where type =~ 'microsoft.containerservice/managedclusters'
| mv-expand e0 = properties.agentPoolProfiles
| extend subnetId = tolower(tostring(e0.vnetSubnetID))
| extend linkedId = substring(subnetId, 0, indexof(subnetId, '/subnets/'))
| where isnotempty(linkedId)
| summarize by name, id, location, type, linkedId
| join kind=inner (resources | where type =~ 'microsoft.network/virtualnetworks' | project linkedId = tolower(id), linkedName = name, linkedType = type, linkedRegion = location) on linkedId
| project
    primaryResourceName = name,
    primaryResourceId = id,
    primaryResourceLocation = location,
    primaryResourceType = type,
    linkedResourceId = linkedId,
    linkedResourceName = linkedName,
    linkedResourceType = linkedType,
    linkedResourceRegion = linkedRegion
