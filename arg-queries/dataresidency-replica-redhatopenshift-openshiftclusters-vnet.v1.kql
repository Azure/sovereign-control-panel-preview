// Find virtual networks referenced by Azure Red Hat OpenShift cluster nodes.
// Combine master and worker subnet references and look up their distinct parent networks.
// Return details of both resources, including their locations.

resources
| where type =~ "microsoft.redhatopenshift/openshiftclusters"
| extend subnetId = tolower(tostring(properties.masterProfile.subnetId))
| extend linkedId = substring(subnetId, 0, indexof(subnetId, "/subnets/"))
| project name, id, location, type, linkedId
| union
    (resources
    | where type =~ "microsoft.redhatopenshift/openshiftclusters"
    | mv-expand e0 = properties.workerProfiles
    | extend subnetId = tolower(tostring(e0.subnetId))
    | extend linkedId = substring(subnetId, 0, indexof(subnetId, "/subnets/"))
    | project name, id, location, type, linkedId)
| distinct name, id, location, type, linkedId
| join kind=leftouter (
    resources
    | where type =~ "microsoft.network/virtualnetworks"
    | project
        linkedId = tolower(id),
        linkedName = name,
        linkedType = type,
        linkedRegion = location
) on linkedId
| project
    primaryResourceName = name,
    primaryResourceId = id,
    primaryResourceLocation = location,
    primaryResourceType = type,
    linkedResourceId = linkedId,
    linkedResourceName = linkedName,
    linkedResourceType = linkedType,
    linkedResourceRegion = linkedRegion
