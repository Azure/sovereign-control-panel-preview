// Find App Configuration stores configured with a customer-managed encryption key.
// Extract the vault name from each key URL and look up the matching Key Vault.
// Return details of both resources, including their locations.

resources
| where type =~ 'microsoft.appconfiguration/configurationstores'
| extend keyId = tostring(properties.encryption.keyVaultProperties.keyIdentifier)
| where isnotempty(keyId)
| extend kvName = tolower(tostring(split(replace_string(keyId, 'https://', ''), '.')[0]))
| join kind=leftouter (
    resources
    | where type =~ 'microsoft.keyvault/vaults'
    | project kvName = tolower(name), linkedResourceId = tolower(id), linkedName = name, linkedLocation = location
  ) on kvName
| project
    primaryResourceName = name,
    primaryResourceId = id,
    primaryResourceLocation = location,
    primaryResourceType = type,
    linkedResourceId,
    linkedResourceName = linkedName,
    linkedResourceType = 'microsoft.keyvault/vaults',
    linkedResourceRegion = linkedLocation
