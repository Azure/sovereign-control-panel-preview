// DataResidencyReplica: an App Configuration store's customer-managed key (CMK) resolves to a Key
// Vault; the handler checks that vault's location against the allowed set. Source: Replication
// Residency Matrix, 'Linked Resources' sheet (Microsoft.AppConfiguration/configurationStores -> Key Vault).
// Validated 2026-09-28 against live resources in the Integration subscription.
resources
| where type =~ 'microsoft.appconfiguration/configurationstores'
| extend keyId = tostring(properties.encryption.keyVaultProperties.keyIdentifier)
| where isnotempty(keyId)
| extend kvName = tolower(tostring(split(replace_string(keyId, 'https://', ''), '.')[0]))
| join kind=leftouter (
    resources
    | where type =~ 'microsoft.keyvault/vaults'
    | project kvName = tolower(name), linkedResourceId = tolower(id), linkedName = name, linkedLocation = location
  ) on kvName
| project
    primaryResourceName = name,
    primaryResourceId = id,
    primaryResourceLocation = location,
    primaryResourceType = type,
    linkedResourceId,
    linkedResourceName = linkedName,
    linkedResourceType = 'microsoft.keyvault/vaults',
    linkedResourceRegion = linkedLocation
