// Find Key Vaults referenced by Container Instances container group encryption settings.
// Extract vault names from the configured vault URLs and return matching vault resources.
// Return details of both resources, including their locations.

resources
| where type =~ "microsoft.containerinstance/containergroups"
| extend vaultBaseUrl = tostring(properties.encryptionProperties.vaultBaseUrl)
| extend refName = tolower(tostring(split(replace_string(replace_string(vaultBaseUrl, "https://", ""), "http://", ""), ".")[0]))
| join kind=leftouter (
    resources
    | where type =~ "microsoft.keyvault/vaults"
    | project refName = tolower(name), linkedId = id, linkedName = name, linkedType = type, linkedRegion = location
) on refName
| where isnotempty(linkedId)
| project
    primaryResourceName = name,
    primaryResourceId = id,
    primaryResourceLocation = location,
    primaryResourceType = type,
    linkedResourceId = linkedId,
    linkedResourceName = linkedName,
    linkedResourceType = linkedType,
    linkedResourceRegion = linkedRegion
