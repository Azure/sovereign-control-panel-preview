resources
| where type =~ "microsoft.documentdb/databaseaccounts"
| extend keyUri = tostring(properties.keyVaultKeyUri)
| extend vaultKey = tolower(tostring(split(replace_string(keyUri, "https://", ""), ".")[0]))
| join kind=inner (
    resources
    | where type =~ "microsoft.keyvault/vaults"
    | project
        vaultKey = tolower(name),
        linkedId = id,
        linkedName = name,
        linkedType = type,
        linkedRegion = location
) on vaultKey
| project
    primaryResourceName = name,
    primaryResourceId = id,
    primaryResourceLocation = location,
    primaryResourceType = type,
    linkedResourceId = linkedId,
    linkedResourceName = linkedName,
    linkedResourceType = linkedType,
    linkedResourceRegion = linkedRegion
