// DataResidencyReplica: a virtual machine's proximity placement group (PPG) is a linked resource whose
// location must fall within the allowed set. Source: Replication Residency Matrix, 'Linked Resources'
// sheet (Microsoft.Compute/virtualMachines -> Proximity Placement Group). Validated live in the
// Integration subscription (2026-09-29).
resources
| where type =~ 'microsoft.compute/virtualmachines'
| extend linkedPpgId = tolower(tostring(properties.proximityPlacementGroup.id))
| where isnotempty(linkedPpgId)
| join kind=leftouter (
    resources
    | where type =~ 'microsoft.compute/proximityplacementgroups'
    | project linkedPpgId = tolower(id), linkedName = name, linkedLocation = location
  ) on linkedPpgId
| project
    primaryResourceName = name,
    primaryResourceId = id,
    primaryResourceLocation = location,
    primaryResourceType = type,
    linkedResourceId = linkedPpgId,
    linkedResourceName = linkedName,
    linkedResourceType = 'microsoft.compute/proximityplacementgroups',
    linkedResourceRegion = linkedLocation
