// Find proximity placement groups referenced by virtual machines.
// Read each virtual machine's placement group ID and look up the matching resource.
// Return details of both resources, including their locations.

resources
| where type =~ 'microsoft.compute/virtualmachines'
| extend linkedPpgId = tolower(tostring(properties.proximityPlacementGroup.id))
| where isnotempty(linkedPpgId)
| join kind=leftouter (
    resources
    | where type =~ 'microsoft.compute/proximityplacementgroups'
    | project linkedPpgId = tolower(id), linkedName = name, linkedLocation = location
  ) on linkedPpgId
| project
    primaryResourceName = name,
    primaryResourceId = id,
    primaryResourceLocation = location,
    primaryResourceType = type,
    linkedResourceId = linkedPpgId,
    linkedResourceName = linkedName,
    linkedResourceType = 'microsoft.compute/proximityplacementgroups',
    linkedResourceRegion = linkedLocation
