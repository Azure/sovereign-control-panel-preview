// Find Key Vaults referenced by API Management custom hostname configurations.
// Extract vault names from the configured Key Vault URLs and keep matching vault resources.
// Return details of both resources, including their locations.

resources
| where type =~ "microsoft.apimanagement/service"
| mv-expand link = properties.hostnameConfigurations
| extend kvHost = tostring(link.keyVaultId)
| where isnotempty(kvHost)
| extend kvName =
    tolower(split(replace_string(kvHost, "https://", ""), ".")[0])
| join kind=leftouter (
    resources
    | where type =~ "microsoft.keyvault/vaults"
    | project
        kvName = tolower(name),
        linkedId = id,
        linkedName = name,
        linkedType = type,
        linkedRegion = location
) on kvName
| where isnotempty(linkedId)
| project
    primaryResourceName = name,
    primaryResourceId = id,
    primaryResourceLocation = location,
    primaryResourceType = type,
    linkedResourceId = linkedId,
    linkedResourceName = linkedName,
    linkedResourceType = linkedType,
    linkedResourceRegion = linkedRegion
| distinct primaryResourceName, primaryResourceId, primaryResourceLocation, primaryResourceType, linkedResourceId, linkedResourceName, linkedResourceType, linkedResourceRegion
