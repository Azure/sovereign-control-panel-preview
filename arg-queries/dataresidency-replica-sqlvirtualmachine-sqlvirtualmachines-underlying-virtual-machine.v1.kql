// Find Compute virtual machines referenced by SQL virtual machine resources.
// Read each SQL virtual machine's underlying virtual machine ID and return matching Compute
// resources.
// Return details of both resources, including their locations.

resources
| where type =~ "microsoft.sqlvirtualmachine/sqlvirtualmachines"
| extend linkedKey = tolower(tostring(properties.virtualMachineResourceId))
| where isnotempty(linkedKey)
| join kind=inner (
    resources
    | where type =~ "microsoft.compute/virtualmachines"
    | project linkedKey = tolower(id), linkedId = id, linkedName = name, linkedType = type, linkedRegion = location
) on linkedKey
| project
    primaryResourceName = name,
    primaryResourceId = id,
    primaryResourceLocation = location,
    primaryResourceType = type,
    linkedResourceId = linkedId,
    linkedResourceName = linkedName,
    linkedResourceType = linkedType,
    linkedResourceRegion = linkedRegion
