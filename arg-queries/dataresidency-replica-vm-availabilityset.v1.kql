// DataResidencyReplica: a virtual machine's availability set is a linked resource whose location must
// fall within the allowed set. Source: Replication Residency Matrix, 'Linked Resources' sheet
// (Microsoft.Compute/virtualMachines -> Availability Set). Validated live in the Integration
// subscription (2026-09-29).
resources
| where type =~ 'microsoft.compute/virtualmachines'
| extend linkedAvsetId = tolower(tostring(properties.availabilitySet.id))
| where isnotempty(linkedAvsetId)
| join kind=leftouter (
    resources
    | where type =~ 'microsoft.compute/availabilitysets'
    | project linkedAvsetId = tolower(id), linkedLocation = location
  ) on linkedAvsetId
| project
    primaryResourceId = id,
    linkedResourceId = linkedAvsetId,
    linkedResourceType = 'microsoft.compute/availabilitysets',
    location = linkedLocation
