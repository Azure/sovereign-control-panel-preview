// Find Key Vaults referenced by managed disk encryption settings.
// Read the source vault IDs from the disk encryption key entries and look up matching vaults.
// Return details of both resources, including their locations.

resources
| where type =~ "microsoft.compute/disks"
| mv-expand link = properties.encryptionSettingsCollection.encryptionSettings
| extend linkedId = tolower(tostring(link.diskEncryptionKey.sourceVault.id))
| where isnotempty(linkedId)
| join kind=leftouter (resources
    | project linkedId = tolower(id), linkedName = name, linkedType = type, linkedRegion = location) on linkedId
| project
    primaryResourceName = name,
    primaryResourceId = id,
    primaryResourceLocation = location,
    primaryResourceType = type,
    linkedResourceId = linkedId,
    linkedResourceName = linkedName,
    linkedResourceType = linkedType,
    linkedResourceRegion = linkedRegion
| distinct primaryResourceName, primaryResourceId, primaryResourceLocation, primaryResourceType, linkedResourceId, linkedResourceName, linkedResourceType, linkedResourceRegion
