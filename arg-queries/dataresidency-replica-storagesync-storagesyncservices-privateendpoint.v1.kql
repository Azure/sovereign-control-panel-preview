// Find private endpoints referenced by Storage Sync services.
// Expand the private endpoint connections and look up each referenced endpoint resource ID.
// Return details of both resources, including their locations.

resources
| where type =~ "microsoft.storagesync/storagesyncservices"
| mv-expand connection = properties.privateEndpointConnections
| extend normalizedLinkedId = tolower(tostring(connection.properties.privateEndpoint.id))
| join kind=leftouter (
    resources
    | where type =~ "microsoft.network/privateendpoints"
    | project
        normalizedLinkedId = tolower(id),
        linkedId = id,
        linkedName = name,
        linkedType = type,
        linkedRegion = location
) on normalizedLinkedId
| project
    primaryResourceName = name,
    primaryResourceId = id,
    primaryResourceLocation = location,
    primaryResourceType = type,
    linkedResourceId = linkedId,
    linkedResourceName = linkedName,
    linkedResourceType = linkedType,
    linkedResourceRegion = linkedRegion
| distinct primaryResourceName, primaryResourceId, primaryResourceLocation, primaryResourceType, linkedResourceId, linkedResourceName, linkedResourceType, linkedResourceRegion
